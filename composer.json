{
    "name": "mazfreelance/encrypted-content-encoding",
    "description": "Encrypted Content-Encoding for HTTP (RFC8188)",
    "keywords": ["encryption", "rfc8188", "middleware", "encoding", "aes128gcm"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mhd Azmin",
            "homepage": "https://mohdazmin.com",
            "email": "me@mohdazmin.com"
        }
    ],
    "support": {
        "issues": "https://github.com/mazfreelance/encrypted-content-encoding/issues",
        "source": "https://github.com/mazfreelance/encrypted-content-encoding",
        "docs": "https://github.com/mazfreelance/encrypted-content-encoding"
    },
    "require": {
        "php": ">=8.0",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "Mazfreelance\\EncryptedContentEncoding\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mazfreelance\\EncryptedContentEncoding\\Test\\": "test/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "spomky-labs/base64url": "^2.0"
    }
}
